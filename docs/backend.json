
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Basic information about the application user including their role and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "editor"] },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "username": { "type": "string" },
        "publicProfileEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "CmsPage": {
      "title": "CMS Page",
      "description": "A dynamic page managed via the admin dashboard.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "trash"] },
        "featuredImage": { "type": "string" },
        "seo": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "keywords": { "type": "array", "items": { "type": "string" } },
            "ogImage": { "type": "string" }
          }
        },
        "authorId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document."
    },
    "/pages/{pageId}": {
      "schema": "CmsPage",
      "description": "Dynamic site pages."
    },
    "/pages/{pageId}/sections/{sectionId}": {
      "schema": "object",
      "description": "Page content sections (Hero, About, etc)."
    },
    "/blog_posts/{postId}": {
      "schema": "object",
      "description": "Career resource blog articles."
    }
  }
}
